---
import '../styles/global.css';

const site = 'https://resume.nicolaslecocq.com';
const title = 'Free ATS Friendly Resume Checker · Parseable';
const description =
  'Free ATS friendly resume checker. Paste a job posting, see which required keywords you match, and export a PDF screening software reads correctly.';

const steps = [
  { id: 'details', label: 'Details' },
  { id: 'template', label: 'Template' },
  { id: 'posting', label: 'Job posting' },
  { id: 'export', label: 'Download' },
];

const faq = [
  {
    q: 'What is an ATS and why does it reject resumes?',
    a: 'An applicant tracking system is the software an employer uses to receive applications. It extracts the text from your file, sorts it into fields such as employer, job title and dates, then scores those fields against the job requisition. Most resumes fail at the sorting step rather than the scoring step. A two column layout with a skills sidebar is the usual culprit, because the extractor reads the page in one pass and interleaves the columns, so your employer and your dates land in the wrong fields before anyone reads a word.',
  },
  {
    q: 'Does this ATS friendly resume checker store my data?',
    a: 'Nothing is stored, because there is no database, no account and no server that receives your file. Your resume, your photo and the job posting you paste are held in the browser tab and disappear when you close it. That is also why the JSON export exists: it is the only copy, so download it if you want to come back later.',
  },
  {
    q: 'Should I put white keywords on my resume to get past the AI?',
    a: 'No, and this builder will not do it. Parsers strip styling and read the raw text layer, so a block of white on white keywords lands in the middle of the recruiter screen looking exactly like what it is. Screening platforms flag the pattern, and a flagged application can be rejected automatically with a fraud marker attached to your candidate record, which follows you across every future role at that company. The same applies to hidden instructions aimed at an AI reader. Putting the same words in visibly, inside your summary and your real bullets, scores identically and survives a human reading it.',
  },
  {
    q: 'What resume format parses most reliably?',
    a: 'A PDF with a real text layer, in one column, with standard headings such as Professional Summary, Experience, Skills and Education. Keep your contact details in the body of the document rather than in a page header, use one date format throughout, and avoid tables, text boxes and letter spacing on headings. Letter spacing is the quiet one: it survives into the text layer and your heading comes out as a string of separated capitals that no parser recognises.',
  },
  {
    q: 'Should I put a photo on my resume?',
    a: 'It depends where you are applying. A photo is normal in France, Germany, Switzerland, Spain and much of continental Europe. In the United Kingdom, Ireland and the United States it is usually left off, because employers avoid material that could support a discrimination claim. The photo toggle is off by default here, so turn it on only when you know the local convention.',
  },
  {
    q: 'How long should a resume be?',
    a: 'One page for under about eight years of work, two pages beyond that. Cutting a fifteen year career onto one page throws away keyword surface that the requisition is scoring you on, and no recruiter has ever rejected a strong second page. What does hurt is padding, so every line should either carry a keyword the job asked for or a result worth reading.',
  },
  {
    q: 'Can I check a resume I already have against a job description?',
    a: 'Yes, and that is what the posting step is for. Drop your current resume in as a PDF and the text is extracted in your browser, then sorted into fields for you to correct, which takes a couple of minutes on most files. Paste the job description into the posting step and the checker lists every required term the posting asks for, marks the ones your resume already contains, and shows a match rate. You decide which of the missing terms are genuinely true of you before any of them is added.',
  },
  {
    q: 'Is it really free, and can I run it myself?',
    a: 'It is free and you can run your own copy. The code is MIT licensed on GitHub, there is nothing to pay for and nothing to sign up to. Since the whole thing is a static page with no backend, you can clone the repository and host your own copy anywhere that serves files.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}/#app`,
      name: 'Parseable',
      url: site,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Any browser',
      description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Import an existing resume from PDF in the browser',
        'Match a resume against a job posting and score the required keywords',
        'Show the exact text an applicant tracking system extracts',
        'Export and re-import a resume as JSON',
        'Print to a PDF with a real text layer',
      ],
      author: { '@id': `${site}/#author` },
      isAccessibleForFree: true,
    },
    {
      '@type': 'Person',
      '@id': `${site}/#author`,
      name: 'Nicolas Lecocq',
      url: 'https://nicolaslecocq.com/',
      jobTitle: 'Full Stack Developer',
    },
    {
      '@type': 'HowTo',
      name: 'How to build a resume that passes an ATS',
      description: 'Import your existing resume, correct the extracted fields, pick a template, paste the job posting, then export a PDF with a real text layer.',
      totalTime: 'PT10M',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Import', text: 'Drop in your current resume as a PDF, or import a JSON file you exported here before.' },
        { '@type': 'HowToStep', position: 2, name: 'Correct the details', text: 'Check the fields the extractor filled in and add anything it missed.' },
        { '@type': 'HowToStep', position: 3, name: 'Pick a template', text: 'Choose one of three single column layouts, all built to parse cleanly.' },
        { '@type': 'HowToStep', position: 4, name: 'Match the posting', text: 'Paste the job description and see which required keywords your resume already contains.' },
        { '@type': 'HowToStep', position: 5, name: 'Download', text: 'Print to PDF, and export the JSON so the next application takes a minute.' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${site}/#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site + '/'} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="preload" href="/fonts/plex-2.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={site + '/'} />
  <meta property="og:title" content="Parseable, a free ATS friendly resume checker" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={site + '/og.png'} />
  <meta property="og:locale" content="en" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Parseable, a free ATS friendly resume checker" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={site + '/og.png'} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</head>
<body>

<header class="site-head sticky top-0 z-40 transition-[background-color,backdrop-filter] duration-300" data-head>
  <div class="mx-auto flex h-16 max-w-[1120px] items-center gap-6 px-6">
    <a href="/" class="font-ui text-[16px] font-semibold tracking-[-0.01em] no-underline">Parseable</a>
    <nav class="ml-auto flex items-center gap-5 whitespace-nowrap text-[14px] text-ink-2 sm:gap-7">
      <a href="#read" class="no-underline transition-colors hover:text-ink">Why resumes fail</a>
      <a href="#faq" class="no-underline transition-colors hover:text-ink">Questions</a>
      <a href="https://github.com/DigiHold/parseable" rel="noopener" target="_blank" class="no-underline transition-colors hover:text-ink">Source</a>
    </nav>
  </div>
</header>

<main class="dropzone" data-drop="pdf">
  <section class="mx-auto max-w-[1120px] px-6 pb-12 pt-16 sm:pt-24 sm:pb-16">
    <h1 class="mb-6 max-w-[13ch] text-[clamp(44px,7vw,92px)]">Get past the software and in front of a person</h1>
    <p class="mb-8 max-w-[44ch] text-[18px] leading-[1.55] text-ink-2 sm:text-[20px]">Software reads your resume before a human does. Check yours against the job posting and download a PDF the screening system reads correctly. Nothing leaves your browser.</p>
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-5">
      <button class="btn btn-primary btn-xl w-full sm:w-auto" data-action="pick-pdf">Upload your resume</button>
      <p class="m-0 text-[15px] text-ink-2"><span class="hidden [@media(hover:hover)]:inline">or drop a PDF anywhere on this page, or </span><button class="cursor-pointer border-0 bg-transparent p-0 text-[inherit] text-ink-2 underline hover:text-ink" data-action="import-json">import a saved JSON</button>.</p>
    </div>
    <input type="file" accept="application/pdf" class="hidden" data-file="pdf">
    <input type="file" accept="application/json,.json" class="hidden" data-file="json">
    <p class="mt-4 text-[14px] text-ink-3" data-role="pdf-status"></p>
  </section>

  <!-- the tool, open on arrival -->
  <section id="workspace" class="scroll-mt-[80px]">
    <div class="mx-auto max-w-[1120px] px-6 pb-20">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3 border-t border-rule pt-5">
        <ol class="m-0 flex list-none flex-wrap gap-2 p-0" id="steps">
          {steps.map((s, i) => (
            <li>
              <button class="step-btn" data-step={s.id} aria-current={i === 0 ? 'step' : undefined}>
                <span class="step-num"><span>{i + 1}</span></span>
                <span class="step-label">{s.label}</span>
              </button>
            </li>
          ))}
        </ol>
        <div class="flex items-center gap-4">
          <p class="m-0 text-[13.5px] text-ink-3" data-role="demo-note">A sample resume is loaded. Upload yours to replace it, or <button class="cursor-pointer border-0 bg-transparent p-0 text-[inherit] underline hover:text-ink" data-action="blank">start from scratch</button>.</p>
          <button class="btn btn-primary btn-sm" data-action="print">Download PDF</button>
        </div>
      </div>

      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,420px)_minmax(0,1fr)]">
        <div class="overflow-hidden rounded-[4px] border border-rule bg-paper">
          <div id="panels"></div>
          <div class="flex gap-3 border-t border-rule px-6 py-5">
            <button class="btn btn-ghost flex-1" data-nav="prev">Back</button>
            <button class="btn btn-primary flex-1" data-nav="next">Continue</button>
          </div>
        </div>

        <div class="lg:sticky lg:top-[84px]">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <div class="inline-flex rounded-[4px] border border-rule bg-paper p-0.5" role="tablist" aria-label="Preview mode">
              <button class="rounded-[3px] border-0 bg-transparent px-3.5 py-1.5 font-ui text-[13.5px] font-medium text-ink-2 cursor-pointer transition-colors aria-selected:bg-ink aria-selected:text-white" role="tab" aria-selected="true" data-view="human">What a person sees</button>
              <button class="rounded-[3px] border-0 bg-transparent px-3.5 py-1.5 font-ui text-[13.5px] font-medium text-ink-2 cursor-pointer transition-colors aria-selected:bg-ink aria-selected:text-white" role="tab" aria-selected="false" data-view="parser">What the software reads</button>
            </div>
            <div class="zoomctl ml-auto flex items-center gap-1.5">
              <button class="icon-btn" data-zoom="-1" aria-label="Zoom out">−</button>
              <span class="min-w-[40px] text-center font-mono text-[12px] text-ink-3" id="zoomval">60%</span>
              <button class="icon-btn" data-zoom="1" aria-label="Zoom in">+</button>
            </div>
          </div>
          <div class="stage max-h-[calc(100vh-150px)] overflow-auto rounded-[4px] border border-rule bg-canvas p-6">
            <div class="sheet-scale flex origin-top justify-center transition-transform duration-200" id="scale">
              <article class="sheet" id="sheet" data-tpl="classic"></article>
            </div>
            <div class="parser-out">
              <p class="mb-3 text-[14px] text-ink-2">This is the plain text a parser pulls out of your PDF. If a heading or a date looks wrong here, it is wrong in the employer's system too.</p>
              <pre class="m-0 max-h-[calc(100vh-220px)] overflow-auto whitespace-pre-wrap break-words rounded-[4px] border border-rule bg-paper p-6 font-mono text-[12.5px] leading-[1.7] text-ink" id="parser"></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- why resumes fail, in the extractor's own output -->
  <section id="read" class="scroll-mt-[80px] border-t border-rule">
    <div class="mx-auto max-w-[1120px] px-6 py-20">
      <h2 class="mb-4 max-w-[18ch] text-[clamp(30px,4vw,48px)]">What the software read from a two column resume</h2>
      <p class="mb-10 max-w-[56ch] text-[18px] text-ink-2">The extractor reads a page in one pass and interleaves the columns. This is its output for a real resume with a skills sidebar, with the three places where the application dies marked.</p>
      <div class="read">
        <pre aria-label="Text extracted by a parser">NICOLAS LECOCQ
Full Stack Developer

<s>Skills</s>                    <s>Experience</s>
<b>WordPress                 Founder &amp; Developer          2025 - 2026</b>
HTML/CSS                  At Vayalis, my own company, I develop and
Vercel                    launch my own products, handling the full
Cloudflare                cycle from idea to release.
React                     <b>Web Designer                   2023 - 2025</b>
Next.js                   Trivial Mass SA, Lausanne
Node.js                   Graphic integration, website development,
PHP                       <i>client follow up management</i>, as well as
SQL                       invoicing.

<s>Language</s>                  <i>client relations to understand their</i>
French                    <i>requirements</i>, and monitoring the specs.
English</pre>
        <ol>
          <li><span class="num">1</span><div><h3>The layout breaks the extractor</h3><p>"WordPress" and "Founder" land on one line, so the parser files the job title under the skills column and the employer under nothing at all.</p></div></li>
          <li><span class="num">2</span><div><h3>The words do not match the posting</h3><p>The posting asked for "stakeholder management". The resume says "client follow up" and "client relations", so that requirement scores zero, whatever the work was.</p></div></li>
          <li><span class="num">3</span><div><h3>Nobody tells you which one it was</h3><p>The rejection email is the same in both cases, so most people rewrite the cover letter and send the same unreadable file again.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section id="faq" class="scroll-mt-[80px] border-t border-rule">
    <div class="mx-auto max-w-[1120px] px-6 py-20">
      <h2 class="mb-8 max-w-[20ch] text-[clamp(30px,4vw,48px)]">What people ask before they trust a resume checker</h2>
      <div class="faq-panel max-w-[720px]">
        {faq.map((f) => (
          <article data-faq-a>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</main>

<footer class="border-t border-rule">
  <div class="mx-auto flex max-w-[1120px] flex-wrap items-center gap-x-8 gap-y-4 px-6 py-10 text-[14px] text-ink-2">
    <p class="inline-flex flex-wrap items-center gap-[.35rem] m-0">Made with love in <svg class="inline-block h-[15px] w-[15px] rounded-full align-middle" viewBox="0 0 512 512" role="img" aria-label="France"><circle cx="256" cy="256" fill="#fff" r="256"></circle><path d="m512 256c0-110.071-69.472-203.906-166.957-240.077v480.155c97.485-36.172 166.957-130.007 166.957-240.078z" fill="#d80027"></path><path d="m0 256c0 110.071 69.473 203.906 166.957 240.077v-480.154c-97.484 36.171-166.957 130.006-166.957 240.077z" fill="#0052b4"></path></svg> by <a class="inline-flex items-center gap-[.4rem] text-fg-2 transition-colors duration-200 ease-soft hover:text-accent-text [&>img]:w-[1.35rem] [&>img]:h-[1.35rem] [&>img]:rounded-full [&>img]:object-cover [&>img]:border [&>img]:border-line-2" href="https://nicolaslecocq.com/" rel="noopener noreferrer" target="_blank"><img src="/nicolas.avif" width="24" height="24" alt="" loading="lazy" decoding="async">Nicolas Lecocq</a></p>
    <nav class="ml-auto flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href="https://github.com/DigiHold/parseable" rel="noopener" target="_blank" class="text-ink-2 no-underline hover:text-ink">Source on GitHub</a>
      <a href="https://github.com/DigiHold/parseable/blob/main/LICENSE" rel="noopener" target="_blank" class="text-ink-2 no-underline hover:text-ink">MIT licence</a>
      <span class="flex items-center gap-3">
        <span class="text-ink-3">Follow me on</span>
        <a href="https://x.com/NicolasLecocqHQ" rel="noopener me" target="_blank" aria-label="Nicolas Lecocq on X" class="transition-colors hover:text-ink"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
        <a href="https://www.linkedin.com/in/lecocq-nicolas/" rel="noopener me" target="_blank" aria-label="Nicolas Lecocq on LinkedIn" class="transition-colors hover:text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13M7.12 20.45H3.55V9h3.57zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0"/></svg></a>
      </span>
    </nav>
  </div>
</footer>

<div id="print-root" aria-hidden="true"></div>

<script>
  document.documentElement.classList.add('js');
  import '../scripts/app';
  import { mountSite } from '../scripts/site';
  mountSite();
</script>
</body>
</html>
