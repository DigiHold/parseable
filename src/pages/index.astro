---
import '../styles/global.css';

const site = 'https://resume.nicolaslecocq.com';
const title = 'Free ATS Friendly Resume Checker · Parseable';
const description =
  'Free ATS friendly resume checker. Paste a job posting, see which required keywords you match, and export a PDF screening software reads correctly.';

const steps = [
  { id: 'details', label: 'Details' },
  { id: 'template', label: 'Template' },
  { id: 'posting', label: 'Job posting' },
  { id: 'export', label: 'Download' },
];

const faq = [
  {
    q: 'What is an ATS and why does it reject resumes?',
    a: 'An applicant tracking system is the software an employer uses to receive applications. It extracts the text from your file, sorts it into fields such as employer, job title and dates, then scores those fields against the job requisition. Most resumes fail at the sorting step rather than the scoring step. A two column layout with a skills sidebar is the usual culprit, because the extractor reads the page in one pass and interleaves the columns, so your employer and your dates land in the wrong fields before anyone reads a word.',
  },
  {
    q: 'Does this ATS friendly resume checker store my data?',
    a: 'Nothing is stored, because there is no database, no account and no server that receives your file. Your resume, your photo and the job posting you paste are held in the browser tab and disappear when you close it. That is also why the JSON export exists: it is the only copy, so download it if you want to come back later.',
  },
  {
    q: 'Should I put white keywords on my resume to get past the AI?',
    a: 'No, and this builder will not do it. Parsers strip styling and read the raw text layer, so a block of white on white keywords lands in the middle of the recruiter screen looking exactly like what it is. Screening platforms flag the pattern, and a flagged application can be rejected automatically with a fraud marker attached to your candidate record, which follows you across every future role at that company. The same applies to hidden instructions aimed at an AI reader. Putting the same words in visibly, inside your summary and your real bullets, scores identically and survives a human reading it.',
  },
  {
    q: 'What resume format parses most reliably?',
    a: 'A PDF with a real text layer, in one column, with standard headings such as Professional Summary, Experience, Skills and Education. Keep your contact details in the body of the document rather than in a page header, use one date format throughout, and avoid tables, text boxes and letter spacing on headings. Letter spacing is the quiet one: it survives into the text layer and your heading comes out as a string of separated capitals that no parser recognises.',
  },
  {
    q: 'Should I put a photo on my resume?',
    a: 'It depends where you are applying. A photo is normal in France, Germany, Switzerland, Spain and much of continental Europe. In the United Kingdom, Ireland and the United States it is usually left off, because employers avoid material that could support a discrimination claim. The photo toggle is off by default here, so turn it on only when you know the local convention.',
  },
  {
    q: 'How long should a resume be?',
    a: 'One page for under about eight years of work, two pages beyond that. Cutting a fifteen year career onto one page throws away keyword surface that the requisition is scoring you on, and no recruiter has ever rejected a strong second page. What does hurt is padding, so every line should either carry a keyword the job asked for or a result worth reading.',
  },
  {
    q: 'Can I check a resume I already have against a job description?',
    a: 'Yes, and that is what the posting step is for. Drop your current resume in as a PDF and the text is extracted in your browser, then sorted into fields for you to correct, which takes a couple of minutes on most files. Paste the job description into the posting step and the checker lists every required term the posting asks for, marks the ones your resume already contains, and shows a match rate. You decide which of the missing terms are genuinely true of you before any of them is added.',
  },
  {
    q: 'Is it really free, and can I run it myself?',
    a: 'It is free and you can run your own copy. The code is MIT licensed on GitHub, there is nothing to pay for and nothing to sign up to. Since the whole thing is a static page with no backend, you can clone the repository and host your own copy anywhere that serves files.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}/#app`,
      name: 'Parseable',
      url: site,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Any browser',
      description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Import an existing resume from PDF in the browser',
        'Match a resume against a job posting and score the required keywords',
        'Show the exact text an applicant tracking system extracts',
        'Export and re-import a resume as JSON',
        'Print to a PDF with a real text layer',
      ],
      author: { '@id': `${site}/#author` },
      isAccessibleForFree: true,
    },
    {
      '@type': 'Person',
      '@id': `${site}/#author`,
      name: 'Nicolas Lecocq',
      url: 'https://nicolaslecocq.com/',
      jobTitle: 'Full Stack Developer',
    },
    {
      '@type': 'HowTo',
      name: 'How to build a resume that passes an ATS',
      description: 'Import your existing resume, correct the extracted fields, pick a template, paste the job posting, then export a PDF with a real text layer.',
      totalTime: 'PT10M',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Import', text: 'Drop in your current resume as a PDF, or import a JSON file you exported here before.' },
        { '@type': 'HowToStep', position: 2, name: 'Correct the details', text: 'Check the fields the extractor filled in and add anything it missed.' },
        { '@type': 'HowToStep', position: 3, name: 'Pick a template', text: 'Choose one of three single column layouts, all built to parse cleanly.' },
        { '@type': 'HowToStep', position: 4, name: 'Match the posting', text: 'Paste the job description and see which required keywords your resume already contains.' },
        { '@type': 'HowToStep', position: 5, name: 'Download', text: 'Print to PDF, and export the JSON so the next application takes a minute.' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${site}/#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site + '/'} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={site + '/'} />
  <meta property="og:title" content="Parseable, a free ATS friendly resume checker" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={site + '/og.png'} />
  <meta property="og:locale" content="en" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Parseable, a free ATS friendly resume checker" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={site + '/og.png'} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</head>
<body>

<header class="sticky top-0 z-40 bg-page/80 backdrop-blur-md">
  <div class="mx-auto flex h-[72px] max-w-[1240px] items-center gap-6 px-6">
    <a href="/" class="flex items-center gap-2.5 font-display text-[20px] font-bold tracking-[-0.025em] no-underline">
      <span class="grid h-8 w-8 place-items-center rounded-[9px] bg-ink" aria-hidden="true">
        <svg width="14" height="17" viewBox="0 0 14 17" fill="none"><rect x="0.75" y="0.75" width="12.5" height="15.5" rx="2" stroke="#fff" stroke-width="1.5"/><rect x="3.5" y="5" width="7" height="1.6" fill="#fff"/><rect x="3.5" y="8.2" width="7" height="1.6" fill="#fff"/><rect x="3.5" y="11.4" width="4" height="1.6" fill="#60a5fa"/></svg>
      </span>
      Parseable
    </a>
    <nav class="ml-auto hidden items-center gap-8 text-[15px] font-medium sm:flex">
      <a href="#how" class="text-ink-2 no-underline transition-colors hover:text-ink">How it works</a>
      <a href="#faq" class="text-ink-2 no-underline transition-colors hover:text-ink">Questions</a>
      <a href="https://github.com/DigiHold/parseable" rel="noopener" target="_blank" class="text-ink-2 no-underline transition-colors hover:text-ink">Source</a>
    </nav>
  </div>
</header>

<main>
  <!-- hero: the sheet, and the software reading it -->
  <section class="overflow-hidden">
    <div class="mx-auto grid max-w-[1240px] items-center gap-10 px-6 pb-16 pt-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-6 lg:pb-24 lg:pt-14">
      <div class="max-w-[600px]">
        <p class="mb-6 font-mono text-[13px] font-medium uppercase tracking-[0.12em] text-ink-3">Free ATS friendly resume checker</p>
        <h1 class="mb-6 text-[clamp(42px,6.2vw,74px)]">Get past the software and in front of a person</h1>
        <p class="mb-9 max-w-[52ch] text-[19px] leading-relaxed text-ink-2">
          Software reads your resume before a human does. Drop yours in, paste the job posting, and
          download a PDF the screening system reads correctly. Nothing leaves your browser.
        </p>

        <div class="dropzone relative max-w-[540px] rounded-[26px] border border-rule bg-paper p-7 shadow-[var(--shadow-float)] sm:p-8" data-drop="pdf">
          <div class="flex flex-wrap items-center gap-4">
            <button class="btn btn-primary btn-xl" data-action="pick-pdf">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4m0 0 4 4m-4-4-4 4"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
              Upload your resume
            </button>
            <div class="min-w-[140px]">
              <p class="m-0 font-display text-[16px] font-semibold text-ink">or drop a PDF here</p>
              <p class="m-0 text-[13.5px] text-ink-3" data-role="pdf-status">Read in your browser, never uploaded.</p>
            </div>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-rule pt-5 text-[14.5px]">
            <button class="cursor-pointer border-0 bg-transparent p-0 font-medium text-ink-2 underline decoration-edge underline-offset-4 transition-colors hover:text-ink hover:decoration-ink" data-action="blank">Start from scratch</button>
            <button class="cursor-pointer border-0 bg-transparent p-0 font-medium text-ink-2 underline decoration-edge underline-offset-4 transition-colors hover:text-ink hover:decoration-ink" data-action="import-json">Import a saved JSON</button>
          </div>
          <input type="file" accept="application/pdf" class="hidden" data-file="pdf">
          <input type="file" accept="application/json,.json" class="hidden" data-file="json">
        </div>

        <p class="mt-7 flex flex-wrap gap-x-6 gap-y-1.5 text-[14px] text-ink-3">
          <span><b class="font-semibold text-ink-2">No account and no database,</b> your file never leaves the tab.</span>
          <span><b class="font-semibold text-ink-2">Open source,</b> MIT licensed, host your own copy.</span>
        </p>
      </div>

      <div class="relative h-[340px] sm:h-[440px] lg:-mr-10 lg:h-[600px]" data-hero-3d aria-hidden="true">
        <!-- painted before three loads, and kept when WebGL is unavailable -->
        <div class="hero-fallback absolute inset-0 grid place-items-center">
          <div class="relative h-[86%] w-[62%] max-w-[300px] rotate-[-6deg] rounded-[6px] bg-paper p-[8%] shadow-[var(--shadow-float)]">
            <i class="fb name"></i><i class="fb role"></i><i class="fb rule"></i>
            <i class="fb head"></i><i class="fb" style="width:100%"></i><i class="fb" style="width:94%"></i><i class="fb" style="width:88%"></i>
            <i class="fb head" style="width:24%"></i><i class="fb" style="width:80%"></i><i class="fb" style="width:72%"></i>
            <div class="fb-beam"></div>
            <div class="fb-machine"><i></i><i class="g"></i><i></i><i class="g"></i><i></i><i></i><i class="g"></i></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- workspace: appears once a resume is loaded -->
  <section id="workspace" class="scroll-mt-[88px] border-t border-rule bg-canvas" hidden>
    <div class="mx-auto max-w-[1240px] px-6 py-10">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <ol class="m-0 flex list-none flex-wrap gap-2 p-0" id="steps">
          {steps.map((s, i) => (
            <li>
              <button class="step-btn" data-step={s.id} aria-current={i === 0 ? 'step' : undefined}>
                <span class="step-num"><span>{i + 1}</span></span>
                <span class="step-label">{s.label}</span>
              </button>
            </li>
          ))}
        </ol>
        <button class="btn btn-primary btn-sm" data-action="print">Download PDF</button>
      </div>

      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,440px)_minmax(0,1fr)]">
        <div class="overflow-hidden rounded-[24px] border border-rule bg-paper shadow-[var(--shadow-card)]">
          <div id="panels"></div>
          <div class="flex gap-3 border-t border-rule px-6 py-5">
            <button class="btn btn-ghost flex-1" data-nav="prev">Back</button>
            <button class="btn btn-primary flex-1" data-nav="next">Continue</button>
          </div>
        </div>

        <div class="lg:sticky lg:top-[92px]">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <div class="inline-flex rounded-full border border-rule bg-paper p-1" role="tablist" aria-label="Preview mode">
              <button class="rounded-full border-0 bg-transparent px-4 py-2 font-display text-[14px] font-semibold text-ink-2 cursor-pointer transition-colors aria-selected:bg-ink aria-selected:text-white" role="tab" aria-selected="true" data-view="human">Human view</button>
              <button class="rounded-full border-0 bg-transparent px-4 py-2 font-display text-[14px] font-semibold text-ink-2 cursor-pointer transition-colors aria-selected:bg-ink aria-selected:text-white" role="tab" aria-selected="false" data-view="parser">Parser view</button>
            </div>
            <div class="zoomctl ml-auto flex items-center gap-1.5">
              <button class="icon-btn" data-zoom="-1" aria-label="Zoom out">−</button>
              <span class="min-w-[40px] text-center font-mono text-[12px] text-ink-3" id="zoomval">60%</span>
              <button class="icon-btn" data-zoom="1" aria-label="Zoom in">+</button>
            </div>
          </div>
          <div class="stage max-h-[calc(100vh-160px)] overflow-auto rounded-[24px] border border-rule bg-[#e9ebef] p-6">
            <div class="sheet-scale flex origin-top justify-center transition-transform duration-200" id="scale">
              <article class="sheet" id="sheet" data-tpl="classic"></article>
            </div>
            <div class="parser-out">
              <p class="mb-3 text-[14px] text-ink-2">This is the plain text a parser pulls out of your PDF. If a heading or a date looks wrong here, it is wrong in the employer's system too.</p>
              <pre class="m-0 max-h-[calc(100vh-220px)] overflow-auto whitespace-pre-wrap break-words rounded-2xl bg-[#0b1220] p-6 font-mono text-[12.5px] leading-[1.7] text-[#d1d5db]" id="parser"></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- where it goes wrong: the pipeline, and the three points on it -->
  <section class="border-t border-rule bg-paper">
    <div class="mx-auto grid max-w-[1240px] gap-12 px-6 py-20 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.4fr)] lg:items-start lg:gap-20 lg:py-28">
      <div data-reveal>
        <p class="mb-5 font-mono text-[13px] font-medium uppercase tracking-[0.12em] text-ink-3">Where it goes wrong</p>
        <h2 class="mb-5 text-[clamp(32px,4.2vw,50px)]">Three points on the line where an application dies</h2>
        <p class="m-0 text-[18px] text-ink-2">Every application crosses the same four stages before a person is involved. The rejection email looks identical whichever stage failed.</p>
      </div>

      <div data-reveal>
        <ol class="pipe">
          <li><span class="pipe-dot"></span><span class="pipe-label">Your PDF</span></li>
          <li class="fails"><span class="pipe-tag">01</span><span class="pipe-dot"></span><span class="pipe-label">Text extraction</span></li>
          <li><span class="pipe-dot"></span><span class="pipe-label">Field sorting</span></li>
          <li class="fails"><span class="pipe-tag">02</span><span class="pipe-dot"></span><span class="pipe-label">Keyword score</span></li>
          <li class="fails"><span class="pipe-tag">03</span><span class="pipe-dot"></span><span class="pipe-label">A person, or the email</span></li>
        </ol>

        <ol class="notes">
          <li>
            <span class="note-num">01</span>
            <div>
              <h3>The layout breaks the extractor</h3>
              <p>A skills sidebar reads as one interleaved run of words, so the parser files your job title under your employer and scores a resume that never existed.</p>
            </div>
          </li>
          <li>
            <span class="note-num">02</span>
            <div>
              <h3>The words do not match the posting</h3>
              <p>Say "worked with teams" where the requisition says "stakeholder management" and the match rate reads zero on that line, whatever you actually did.</p>
            </div>
          </li>
          <li>
            <span class="note-num">03</span>
            <div>
              <h3>Nobody tells you which one it was</h3>
              <p>The rejection email is the same either way, so most people rewrite the cover letter and send the same unreadable file again.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- how it works: the steps on the left, the real interface following on the right -->
  <section id="how" class="scroll-mt-[72px] border-t border-rule">
    <div class="mx-auto grid max-w-[1240px] gap-12 px-6 py-20 lg:grid-cols-2 lg:items-start lg:gap-16 lg:py-28">
      <div>
        <p class="mb-5 font-mono text-[13px] font-medium uppercase tracking-[0.12em] text-ink-3" data-reveal>How it works</p>
        <h2 class="mb-12 max-w-[16ch] text-[clamp(32px,4.2vw,50px)]" data-reveal>Four steps, about ten minutes the first time</h2>
        <ol class="how">
          <li data-how-step="0">
            <h3>Bring what you have</h3>
            <p>Drop in your current resume as a PDF and the text is pulled out in your browser, sorted into fields you then correct. Starting from nothing works too.</p>
          </li>
          <li data-how-step="1">
            <h3>See what the machine reads</h3>
            <p>The parser view shows your document as plain extracted text, the way the employer's software receives it. Anything wrong there is wrong on their screen.</p>
          </li>
          <li data-how-step="2">
            <h3>Answer the actual posting</h3>
            <p>Paste the job description and see which required terms your resume already contains, and which are missing. You decide which missing ones are true of you.</p>
          </li>
          <li data-how-step="3">
            <h3>Download and keep the JSON</h3>
            <p>Print to a PDF that keeps a real text layer, then export the JSON so the next application only costs you the posting step.</p>
          </li>
        </ol>
      </div>

      <div class="lg:sticky lg:top-[104px]">
        <div class="frag-frame" aria-hidden="true">
          <div class="frag" data-how-frag="0">
            <div class="rounded-[22px] border border-rule bg-paper p-6 shadow-[var(--shadow-float)]">
              <div class="flex flex-wrap items-center gap-4">
                <span class="btn btn-primary">Upload your resume</span>
                <span class="font-display text-[15px] font-semibold">or drop a PDF here</span>
              </div>
              <div class="mt-5 border-t border-rule pt-4 text-[13.5px] text-ink-2">Start from scratch &nbsp;&nbsp; Import a saved JSON</div>
            </div>
          </div>
          <div class="frag" data-how-frag="1">
            <div class="mb-3 inline-flex rounded-full border border-rule bg-paper p-1">
              <span class="rounded-full px-4 py-2 font-display text-[14px] font-semibold text-ink-2">Human view</span>
              <span class="rounded-full bg-ink px-4 py-2 font-display text-[14px] font-semibold text-white">Parser view</span>
            </div>
            <pre class="m-0 rounded-2xl bg-[#0b1220] p-6 font-mono text-[12.5px] leading-[1.75] text-[#d1d5db]">Marie Dubois
Senior Backend Engineer
marie@example.com | Lyon, France

PROFESSIONAL SUMMARY
Backend engineer with nine years building
payment systems in Python and Go.

SKILLS
Languages: Python, Go, SQL, TypeScript</pre>
          </div>
          <div class="frag" data-how-frag="2">
            <div class="rounded-[22px] border border-rule bg-paper p-6 shadow-[var(--shadow-float)]">
              <div class="flex items-baseline gap-2.5"><b class="font-display text-[36px] font-bold leading-none tracking-[-0.03em]">83%</b><span class="text-[14px] text-ink-2">of the 6 required terms, 5 matched</span></div>
              <div class="my-3 mb-5 h-1.5 overflow-hidden rounded-full bg-rule"><i class="block h-full w-[83%] rounded-full bg-match"></i></div>
              <div class="flex flex-wrap gap-1.5">
                <span class="chip chip-miss">WCAG</span><span class="chip chip-hit">Accessibility</span><span class="chip chip-hit">JavaScript</span><span class="chip chip-hit">Next.js</span><span class="chip chip-hit">React</span><span class="chip chip-hit">TypeScript</span>
              </div>
            </div>
          </div>
          <div class="frag" data-how-frag="3">
            <div class="rounded-[22px] border border-rule bg-paper p-6 shadow-[var(--shadow-float)]">
              <span class="btn btn-primary mb-3 w-full">Download PDF</span>
              <span class="btn btn-ghost mb-5 w-full">Export JSON</span>
              <div class="notice mb-0"><strong>Name the file plainly</strong>FirstnameLastname_Resume.pdf. Some parsers choke on spaces, brackets and accents.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- questions: an index, one answer at a time -->
  <section id="faq" class="scroll-mt-[72px] border-t border-rule bg-paper">
    <div class="mx-auto max-w-[1240px] px-6 py-20 lg:py-28">
      <div class="mb-12 max-w-[640px]" data-reveal>
        <p class="mb-5 font-mono text-[13px] font-medium uppercase tracking-[0.12em] text-ink-3">Questions</p>
        <h2 class="text-[clamp(32px,4.2vw,50px)]">What people ask before they trust a resume checker</h2>
      </div>
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.3fr)] lg:items-start lg:gap-16" data-reveal>
        <ol class="faq-index">
          {faq.map((f, i) => (
            <li><button type="button" data-faq-q aria-selected={i === 0 ? 'true' : 'false'}><span class="faq-num">{String(i + 1).padStart(2, '0')}</span><span>{f.q}</span></button></li>
          ))}
        </ol>
        <div class="faq-panel">
          {faq.map((f) => (
            <article data-faq-a>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="overflow-hidden border-t border-rule">
  <div class="mx-auto max-w-[1240px] px-6 pt-14">
    <p class="ghost" aria-hidden="true">Parseable</p>
