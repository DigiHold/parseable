---
import '../styles/global.css';

const site = 'https://resume.nicolaslecocq.com';
const title = 'Free ATS Friendly Resume Checker · Parseable';
const description =
  'Free ATS friendly resume checker. Paste a job posting, see which required keywords you match, and export a PDF screening software reads correctly.';

const steps = [
  { id: 'details', label: 'Details' },
  { id: 'template', label: 'Template' },
  { id: 'posting', label: 'Job posting' },
  { id: 'export', label: 'Download' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}/#app`,
      name: 'Parseable',
      url: site,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Any browser',
      description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Import an existing resume from PDF in the browser',
        'Match a resume against a job posting and score the required keywords',
        'Show the exact text an applicant tracking system extracts',
        'Export and re-import a resume as JSON',
        'Print to a PDF with a real text layer',
      ],
      author: { '@id': `${site}/#author` },
      isAccessibleForFree: true,
    },
    {
      '@type': 'Person',
      '@id': `${site}/#author`,
      name: 'Nicolas Lecocq',
      url: 'https://nicolaslecocq.com/',
      jobTitle: 'Full Stack Developer',
    },
    {
      '@type': 'HowTo',
      name: 'How to build a resume that passes an ATS',
      description: 'Import your existing resume, correct the extracted fields, pick a template, paste the job posting, then export a PDF with a real text layer.',
      totalTime: 'PT10M',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Import', text: 'Drop in your current resume as a PDF, or import a JSON file you exported here before.' },
        { '@type': 'HowToStep', position: 2, name: 'Correct the details', text: 'Check the fields the extractor filled in and add anything it missed.' },
        { '@type': 'HowToStep', position: 3, name: 'Pick a template', text: 'Choose one of three single column layouts, all built to parse cleanly.' },
        { '@type': 'HowToStep', position: 4, name: 'Match the posting', text: 'Paste the job description and see which required keywords your resume already contains.' },
        { '@type': 'HowToStep', position: 5, name: 'Download', text: 'Print to PDF, and export the JSON so the next application takes a minute.' },
      ],
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site + '/'} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="preload" href="/fonts/plex-2.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={site + '/'} />
  <meta property="og:title" content="Parseable, a free ATS friendly resume checker" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={site + '/og.png'} />
  <meta property="og:locale" content="en" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Parseable, a free ATS friendly resume checker" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={site + '/og.png'} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</head>
<body>

<header class="site-head sticky top-0 z-40 text-white transition-colors duration-300" data-head>
  <div class="mx-auto flex h-16 max-w-[1120px] items-center gap-6 px-6">
    <a href="/" class="font-ui text-[16px] font-semibold tracking-[-0.01em] text-current no-underline">Parseable</a>
    <nav class="ml-auto flex items-center gap-5 whitespace-nowrap text-[14px] opacity-80 sm:gap-7">
      <a href="/questions" class="text-current no-underline transition-opacity hover:opacity-100">Questions</a>
      <a href="https://github.com/DigiHold/parseable" rel="noopener" target="_blank" class="text-current no-underline transition-opacity hover:opacity-100">Source</a>
    </nav>
  </div>
</header>

<main class="dropzone" data-drop="pdf">
  <!-- the stage: a sheet of paper under a blade of light -->
  <section class="stage-dark relative -mt-16 overflow-hidden bg-[#0a0b0e] text-white">
    <div class="absolute inset-0" data-hero-3d aria-hidden="true">
      <div class="hero-fallback absolute inset-0"></div>
    </div>
    <div class="relative mx-auto grid min-h-[100svh] max-w-[1120px] grid-cols-1 items-start px-6 pb-[46vh] pt-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:pb-16 lg:pt-16">
      <div class="hero-copy">
        <h1 class="mb-6 text-[clamp(38px,4.6vw,64px)] text-white"><span class="block whitespace-nowrap">Get past the</span><span class="block whitespace-nowrap">software and in</span><span class="block whitespace-nowrap">front of a person</span></h1>
        <p class="mb-8 max-w-[36ch] text-[17px] leading-[1.55] text-white/65">Software reads your resume before a human does. Check yours against the posting and download a PDF it reads correctly.</p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-x-5">
          <button class="btn btn-light btn-xl w-full sm:w-auto" data-action="pick-pdf">Upload your resume</button>
          <p class="m-0 whitespace-nowrap text-center text-[15px] text-white/70 sm:text-left">or <button class="cursor-pointer border-0 bg-transparent p-0 text-[inherit] text-white/80 underline decoration-white/40 underline-offset-4 hover:text-white" data-action="sample">try it with a sample</button></p>
        </div>
        <input type="file" accept="application/pdf" class="hidden" data-file="pdf">
        <input type="file" accept="application/json,.json" class="hidden" data-file="json">
        <p class="mt-4 min-h-[20px] text-[13px] text-white/50" data-role="pdf-status"></p>
      </div>
      <div class="hidden lg:block" aria-hidden="true"></div>
    </div>
  </section>

  <section class="bg-[#0a0b0e] text-white/55" data-role="acts">
    <p class="mx-auto m-0 max-w-[1120px] border-t border-white/10 px-6 py-6 text-[14px]">Extraction, the match against a posting, and a PDF with a real text layer. In your browser, nothing uploaded.</p>
  </section>

  <section id="workspace" class="mx-auto max-w-[1120px] px-6 pb-20 pt-14" hidden>
    <div class="tool">
      <div class="tool-form">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-1 border-b border-rule px-5 pt-3">
          <ol class="m-0 flex list-none flex-wrap gap-x-6 gap-y-1 p-0" id="steps">
            {steps.map((s, i) => (
              <li>
                <button class="step-btn" data-step={s.id} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="step-num"><span>{i + 1}</span></span>
                  <span class="step-label">{s.label}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
        <p class="m-0 border-b border-rule px-5 py-3 text-[13px] text-ink-3" data-role="demo-note">A sample resume is loaded. Upload yours to replace it, or <button class="cursor-pointer border-0 bg-transparent p-0 text-[inherit] underline hover:text-ink" data-action="blank">start from scratch</button>.</p>
        <div id="panels"></div>
        <div class="flex gap-3 border-t border-rule px-5 py-4">
          <button class="btn btn-ghost" data-nav="prev">Back</button>
          <button class="btn btn-primary" data-nav="next">Continue</button>
        </div>
      </div>

      <div class="tool-view">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-rule px-5 pt-3">
          <div class="flex gap-5" role="tablist" aria-label="Preview mode">
            <button class="step-btn" role="tab" aria-selected="true" data-view="human">What a person sees</button>
            <button class="step-btn" role="tab" aria-selected="false" data-view="parser">What the software reads</button>
          </div>
          <div class="zoomctl ml-auto flex items-center gap-1 pb-2">
            <button class="icon-btn" data-zoom="-1" aria-label="Zoom out">−</button>
            <span class="min-w-[40px] text-center font-mono text-[12px] text-ink-3" id="zoomval">66%</span>
            <button class="icon-btn" data-zoom="1" aria-label="Zoom in">+</button>
          </div>
          <button class="btn btn-ghost btn-sm pb-2" data-action="print">Download PDF</button>
        </div>
        <div class="stage max-h-[70vh] overflow-auto bg-canvas p-5">
          <div class="sheet-scale flex origin-top-left justify-start transition-transform duration-200" id="scale">
            <article class="sheet" id="sheet" data-tpl="classic"></article>
          </div>
          <div class="parser-out">
            <pre class="m-0 whitespace-pre-wrap break-words border border-rule bg-paper p-6 font-mono text-[12.5px] leading-[1.7] text-ink" id="parser"></pre>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="bg-[#0a0b0e] text-white/60" data-foot>
  <div class="mx-auto flex max-w-[1120px] flex-wrap items-center gap-x-8 gap-y-4 border-t border-white/10 px-6 py-10 text-[14px]">
    <p class="inline-flex flex-wrap items-center gap-[.35rem] m-0">Made with love in <svg class="inline-block h-[15px] w-[15px] rounded-full align-middle" viewBox="0 0 512 512" role="img" aria-label="France"><circle cx="256" cy="256" fill="#fff" r="256"></circle><path d="m512 256c0-110.071-69.472-203.906-166.957-240.077v480.155c97.485-36.172 166.957-130.007 166.957-240.078z" fill="#d80027"></path><path d="m0 256c0 110.071 69.473 203.906 166.957 240.077v-480.154c-97.484 36.171-166.957 130.006-166.957 240.077z" fill="#0052b4"></path></svg> by <a class="inline-flex items-center gap-[.4rem] text-white/80 transition-colors duration-200 ease-soft hover:text-white [&>img]:w-[1.35rem] [&>img]:h-[1.35rem] [&>img]:rounded-full [&>img]:object-cover [&>img]:border [&>img]:border-line-2" href="https://nicolaslecocq.com/" rel="noopener noreferrer" target="_blank"><img src="/nicolas.avif" width="24" height="24" alt="" loading="lazy" decoding="async">Nicolas Lecocq</a></p>
    <nav class="ml-auto flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href="/questions" class="text-white/60 no-underline hover:text-white">Questions</a>
      <a href="https://github.com/DigiHold/parseable" rel="noopener" target="_blank" class="text-white/60 no-underline hover:text-white">Source on GitHub</a>
      <a href="https://github.com/DigiHold/parseable/blob/main/LICENSE" rel="noopener" target="_blank" class="text-white/60 no-underline hover:text-white">MIT licence</a>
      <a href="https://x.com/NicolasLecocqHQ" rel="noopener me" target="_blank" aria-label="Nicolas Lecocq on X" class="transition-colors hover:text-white"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
      <a href="https://www.linkedin.com/in/lecocq-nicolas/" rel="noopener me" target="_blank" aria-label="Nicolas Lecocq on LinkedIn" class="transition-colors hover:text-white"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13M7.12 20.45H3.55V9h3.57zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0"/></svg></a>
    </nav>
  </div>
</footer>

<div id="print-root" aria-hidden="true"></div>

<script>
  document.documentElement.classList.add('js');
  import '../scripts/app';
  import { mountSite } from '../scripts/site';
  mountSite();
</script>
</body>
</html>
