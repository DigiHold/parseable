---
import '../styles/global.css';

const site = 'https://resume.nicolaslecocq.com';
const title = 'Free ATS Friendly Resume Checker · Parseable';
const description =
  'Free ATS friendly resume checker. Paste a job posting, see which required keywords you match, and export a PDF screening software reads correctly.';

const steps = [
  { id: 'details', label: 'Details' },
  { id: 'template', label: 'Template' },
  { id: 'posting', label: 'Job posting' },
  { id: 'export', label: 'Download' },
];

const faq = [
  {
    q: 'What is an ATS and why does it reject resumes?',
    a: 'An applicant tracking system is the software an employer uses to receive applications. It extracts the text from your file, sorts it into fields such as employer, job title and dates, then scores those fields against the job requisition. Most resumes fail at the sorting step rather than the scoring step. A two column layout with a skills sidebar is the usual culprit, because the extractor reads the page in one pass and interleaves the columns, so your employer and your dates land in the wrong fields before anyone reads a word.',
  },
  {
    q: 'Does this ATS friendly resume checker store my data?',
    a: 'Nothing is stored, because there is no database, no account and no server that receives your file. Your resume, your photo and the job posting you paste are held in the browser tab and disappear when you close it. That is also why the JSON export exists: it is the only copy, so download it if you want to come back later.',
  },
  {
    q: 'Should I put white keywords on my resume to get past the AI?',
    a: 'No, and this builder will not do it. Parsers strip styling and read the raw text layer, so a block of white on white keywords lands in the middle of the recruiter screen looking exactly like what it is. Screening platforms flag the pattern, and a flagged application can be rejected automatically with a fraud marker attached to your candidate record, which follows you across every future role at that company. The same applies to hidden instructions aimed at an AI reader. Putting the same words in visibly, inside your summary and your real bullets, scores identically and survives a human reading it.',
  },
  {
    q: 'What resume format parses most reliably?',
    a: 'A PDF with a real text layer, in one column, with standard headings such as Professional Summary, Experience, Skills and Education. Keep your contact details in the body of the document rather than in a page header, use one date format throughout, and avoid tables, text boxes and letter spacing on headings. Letter spacing is the quiet one: it survives into the text layer and your heading comes out as a string of separated capitals that no parser recognises.',
  },
  {
    q: 'Should I put a photo on my resume?',
    a: 'It depends where you are applying. A photo is normal in France, Germany, Switzerland, Spain and much of continental Europe. In the United Kingdom, Ireland and the United States it is usually left off, because employers avoid material that could support a discrimination claim. The photo toggle is off by default here, so turn it on only when you know the local convention.',
  },
  {
    q: 'How long should a resume be?',
    a: 'One page for under about eight years of work, two pages beyond that. Cutting a fifteen year career onto one page throws away keyword surface that the requisition is scoring you on, and no recruiter has ever rejected a strong second page. What does hurt is padding, so every line should either carry a keyword the job asked for or a result worth reading.',
  },
  {
    q: 'Can I check a resume I already have against a job description?',
    a: 'Yes, and that is what the posting step is for. Drop your current resume in as a PDF and the text is extracted in your browser, then sorted into fields for you to correct, which takes a couple of minutes on most files. Paste the job description into the posting step and the checker lists every required term the posting asks for, marks the ones your resume already contains, and shows a match rate. You decide which of the missing terms are genuinely true of you before any of them is added.',
  },
  {
    q: 'Is it really free, and can I run it myself?',
    a: 'It is free and you can run your own copy. The code is MIT licensed on GitHub, there is nothing to pay for and nothing to sign up to. Since the whole thing is a static page with no backend, you can clone the repository and host your own copy anywhere that serves files.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}/#app`,
      name: 'Parseable',
      url: site,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Any browser',
      description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Import an existing resume from PDF in the browser',
        'Match a resume against a job posting and score the required keywords',
        'Show the exact text an applicant tracking system extracts',
        'Export and re-import a resume as JSON',
        'Print to a PDF with a real text layer',
      ],
      author: { '@id': `${site}/#author` },
      isAccessibleForFree: true,
    },
    {
      '@type': 'Person',
      '@id': `${site}/#author`,
      name: 'Nicolas Lecocq',
      url: 'https://nicolaslecocq.com/',
      jobTitle: 'Full Stack Developer',
    },
    {
      '@type': 'HowTo',
      name: 'How to build a resume that passes an ATS',
      description: 'Import your existing resume, correct the extracted fields, pick a template, paste the job posting, then export a PDF with a real text layer.',
      totalTime: 'PT10M',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Import', text: 'Drop in your current resume as a PDF, or import a JSON file you exported here before.' },
        { '@type': 'HowToStep', position: 2, name: 'Correct the details', text: 'Check the fields the extractor filled in and add anything it missed.' },
        { '@type': 'HowToStep', position: 3, name: 'Pick a template', text: 'Choose one of three single column layouts, all built to parse cleanly.' },
        { '@type': 'HowToStep', position: 4, name: 'Match the posting', text: 'Paste the job description and see which required keywords your resume already contains.' },
        { '@type': 'HowToStep', position: 5, name: 'Download', text: 'Print to PDF, and export the JSON so the next application takes a minute.' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${site}/#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site + '/'} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={site + '/'} />
  <meta property="og:title" content="Parseable, a free ATS friendly resume checker" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={site + '/og.png'} />
  <meta property="og:locale" content="en" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Parseable, a free ATS friendly resume checker" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={site + '/og.png'} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</head>
<body>

<header class="sticky top-0 z-40 bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex h-[68px] max-w-[1200px] items-center gap-6 px-6">
    <a href="/" class="flex items-center gap-2.5 font-display text-[19px] font-bold tracking-[-0.02em] no-underline">
      <span class="grid h-8 w-8 place-items-center rounded-[9px] bg-ink" aria-hidden="true">
        <svg width="14" height="17" viewBox="0 0 14 17" fill="none"><rect x="0.75" y="0.75" width="12.5" height="15.5" rx="2" stroke="#fff" stroke-width="1.5"/><rect x="3.5" y="5" width="7" height="1.6" fill="#fff"/><rect x="3.5" y="8.2" width="7" height="1.6" fill="#fff"/><rect x="3.5" y="11.4" width="4" height="1.6" fill="#60a5fa"/></svg>
      </span>
      Parseable
    </a>
    <nav class="ml-auto hidden items-center gap-7 text-[15px] font-medium sm:flex">
      <a href="#how" class="text-ink-2 no-underline transition-colors hover:text-ink">How it works</a>
      <a href="#faq" class="text-ink-2 no-underline transition-colors hover:text-ink">FAQ</a>
      <a href="https://github.com/DigiHold/parseable" rel="noopener" target="_blank" class="btn btn-ghost btn-sm">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
        GitHub
      </a>
    </nav>
  </div>
</header>

<main>
  <!-- hero: the upload card is the product -->
  <section class="hero-wash">
    <div class="mx-auto max-w-[1200px] px-6 pt-14 pb-16 sm:pt-20 sm:pb-20">
      <div class="mx-auto max-w-[820px] text-center">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-rule bg-paper/80 px-3.5 py-1.5 text-[13.5px] font-medium text-ink-2">
          <span class="h-1.5 w-1.5 rounded-full bg-match"></span>
          Free ATS friendly resume checker
        </p>
        <h1 class="mx-auto mb-5 max-w-[14ch] text-[clamp(40px,6.4vw,68px)]">Get past the software and in front of a person</h1>
        <p class="mx-auto mb-10 max-w-[56ch] text-[19px] leading-relaxed text-ink-2 sm:text-[20px]">
          Software reads your resume before a human does. Drop yours in, paste the job posting, and
          download a PDF the screening system reads correctly. Nothing leaves your browser.
        </p>
      </div>

      <div class="mx-auto grid max-w-[1040px] items-center gap-8 lg:grid-cols-[1fr_1.15fr] lg:gap-12">
        <!-- what the machine reads, drawn in CSS -->
        <div class="relative mx-auto hidden h-[300px] w-full max-w-[420px] lg:block" aria-hidden="true">
          <div class="mini-sheet absolute left-0 top-2 w-[240px] rotate-[-4deg] rounded-xl bg-paper p-6 shadow-[var(--shadow-float)]">
            <i class="h"></i><i class="r"></i>
            <i style="width:100%"></i><i style="width:92%"></i><i style="width:96%"></i>
            <i class="s"></i>
            <i style="width:88%"></i><i style="width:78%"></i><i style="width:90%"></i>
            <i class="s"></i>
            <i style="width:84%"></i><i style="width:70%"></i>
          </div>
          <div class="mini-term absolute right-0 top-[64px] w-[250px] rotate-[3deg] rounded-xl bg-[#111827] p-6 shadow-[var(--shadow-float)]">
            <div class="mb-4 flex gap-1.5"><span class="h-2 w-2 rounded-full bg-[#374151]"></span><span class="h-2 w-2 rounded-full bg-[#374151]"></span><span class="h-2 w-2 rounded-full bg-[#374151]"></span></div>
            <i class="w" style="width:52%"></i><i style="width:38%"></i>
            <i style="width:100%;margin-top:12px"></i><i class="g" style="width:64%"></i><i style="width:88%"></i>
            <i style="width:96%;margin-top:12px"></i><i class="g" style="width:46%"></i><i class="g" style="width:72%"></i><i style="width:80%"></i>
          </div>
          <div class="absolute bottom-0 left-[86px] rounded-full bg-match-bg px-3.5 py-2 font-display text-[13px] font-semibold text-match shadow-[var(--shadow-card)]">83% of required terms matched</div>
        </div>

        <!-- the upload card -->
        <div class="dropzone relative rounded-[28px] border border-rule bg-paper px-8 py-12 text-center shadow-[var(--shadow-float)] sm:px-12 sm:py-14" data-drop="pdf">
          <button class="btn btn-primary btn-xl" data-action="pick-pdf">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4m0 0 4 4m-4-4-4 4"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
            Upload your resume
          </button>
          <p class="mb-1 mt-5 font-display text-[17px] font-semibold text-ink">or drop a PDF here</p>
          <p class="mb-7 text-[14px] text-ink-3" data-role="pdf-status">It is read in your browser and never uploaded.</p>
          <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[14.5px]">
            <button class="cursor-pointer border-0 bg-transparent p-0 font-medium text-ink-2 underline decoration-edge underline-offset-4 transition-colors hover:text-ink hover:decoration-ink" data-action="blank">Start from scratch</button>
            <span class="hidden text-edge sm:inline">·</span>
            <button class="cursor-pointer border-0 bg-transparent p-0 font-medium text-ink-2 underline decoration-edge underline-offset-4 transition-colors hover:text-ink hover:decoration-ink" data-action="import-json">Import a saved JSON</button>
          </div>
          <input type="file" accept="application/pdf" class="hidden" data-file="pdf">
          <input type="file" accept="application/json,.json" class="hidden" data-file="json">
        </div>
      </div>

      <p class="mx-auto mt-10 flex max-w-[820px] flex-wrap items-center justify-center gap-x-7 gap-y-2 text-[14px] text-ink-3">
        <span><b class="font-semibold text-ink-2">No account.</b> Nothing to sign up to.</span>
        <span><b class="font-semibold text-ink-2">No database.</b> Your file never leaves the tab.</span>
        <span><b class="font-semibold text-ink-2">Open source.</b> MIT licensed, host your own.</span>
      </p>
    </div>
  </section>

  <!-- workspace: appears once a resume is loaded -->
  <section id="workspace" class="scroll-mt-[84px] border-t border-rule bg-canvas" hidden>
    <div class="mx-auto max-w-[1200px] px-6 py-10">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <ol class="m-0 flex list-none flex-wrap gap-2 p-0" id="steps">
          {steps.map((s, i) => (
            <li>
              <button class="step-btn" data-step={s.id} aria-current={i === 0 ? 'step' : undefined}>
                <span class="step-num"><span>{i + 1}</span></span>
                <span class="step-label">{s.label}</span>
              </button>
            </li>
          ))}
        </ol>
        <button class="btn btn-primary btn-sm" data-action="print">Download PDF</button>
      </div>

      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,440px)_minmax(0,1fr)]">
        <div class="overflow-hidden rounded-[22px] border border-rule bg-paper shadow-[var(--shadow-card)]">
          <div id="panels"></div>
          <div class="flex gap-3 border-t border-rule px-6 py-5">
            <button class="btn btn-ghost flex-1" data-nav="prev">Back</button>
            <button class="btn btn-primary flex-1" data-nav="next">Continue</button>
          </div>
        </div>

        <div class="lg:sticky lg:top-[88px]">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <div class="inline-flex rounded-full border border-rule bg-paper p-1" role="tablist" aria-label="Preview mode">
              <button class="rounded-full border-0 bg-transparent px-4 py-2 font-display text-[14px] font-semibold text-ink-2 cursor-pointer transition-colors aria-selected:bg-ink aria-selected:text-white" role="tab" aria-selected="true" data-view="human">Human view</button>
              <button class="rounded-full border-0 bg-transparent px-4 py-2 font-display text-[14px] font-semibold text-ink-2 cursor-pointer transition-colors aria-selected:bg-ink aria-selected:text-white" role="tab" aria-selected="false" data-view="parser">Parser view</button>
            </div>
            <div class="zoomctl ml-auto flex items-center gap-1.5">
              <button class="icon-btn" data-zoom="-1" aria-label="Zoom out">−</button>
              <span class="min-w-[40px] text-center font-mono text-[12px] text-ink-3" id="zoomval">60%</span>
              <button class="icon-btn" data-zoom="1" aria-label="Zoom in">+</button>
            </div>
          </div>

          <div class="stage max-h-[calc(100vh-160px)] overflow-auto rounded-[22px] border border-rule bg-[#eceef2] p-6">
            <div class="sheet-scale flex origin-top justify-center transition-transform duration-200" id="scale">
              <article class="sheet" id="sheet" data-tpl="classic"></article>
            </div>
            <div class="parser-out">
              <p class="mb-3 text-[14px] text-ink-2">
                This is the plain text a parser pulls out of your PDF. If a heading or a date looks wrong
                here, it is wrong in the employer's system too.
              </p>
              <pre class="m-0 max-h-[calc(100vh-220px)] overflow-auto whitespace-pre-wrap break-words rounded-2xl bg-[#111827] p-6 font-mono text-[12.5px] leading-[1.7] text-[#d1d5db]" id="parser"></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- why applications die -->
  <section class="mx-auto max-w-[1200px] px-6 py-20 sm:py-24">
    <div class="mx-auto mb-12 max-w-[640px] text-center">
      <h2 class="mb-4 text-[clamp(30px,4vw,42px)]">Three ways an application dies before anyone reads it</h2>
      <p class="m-0 text-[18px] text-ink-2">The rejection email looks the same every time, so most people never find out which one it was.</p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      <div class="rounded-[22px] border border-rule bg-paper p-8 shadow-[var(--shadow-card)]">
        <span class="mb-6 grid h-12 w-12 place-items-center rounded-2xl bg-primary-soft text-primary">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M10 3v18"/><path d="M13 8h4M13 12h4M13 16h2"/><path d="M6.5 8h1M6.5 12h1M6.5 16h1"/></svg>
        </span>
        <h3 class="mb-2.5 text-[19px]">The layout breaks the extractor</h3>
        <p class="m-0 text-[15.5px] text-ink-2">A skills sidebar reads as one interleaved run of words, so the parser files your job title under your employer and scores a resume that never existed.</p>
      </div>
      <div class="rounded-[22px] border border-rule bg-paper p-8 shadow-[var(--shadow-card)]">
        <span class="mb-6 grid h-12 w-12 place-items-center rounded-2xl bg-miss-bg text-miss">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h9M4 12h6M4 17h8"/><path d="m15 9 5 5m0-5-5 5"/></svg>
        </span>
        <h3 class="mb-2.5 text-[19px]">The words do not match the posting</h3>
        <p class="m-0 text-[15.5px] text-ink-2">Say "worked with teams" where the requisition says "stakeholder management" and the match rate reads zero on that line, whatever you actually did.</p>
      </div>
      <div class="rounded-[22px] border border-rule bg-paper p-8 shadow-[var(--shadow-card)]">
        <span class="mb-6 grid h-12 w-12 place-items-center rounded-2xl bg-match-bg text-match">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        </span>
        <h3 class="mb-2.5 text-[19px]">Nobody tells you which one it was</h3>
        <p class="m-0 text-[15.5px] text-ink-2">The rejection email is the same either way, so most people rewrite the cover letter and send the same unreadable file again.</p>
      </div>
    </div>
  </section>

  <!-- how it works -->
  <section id="how" class="border-t border-rule bg-canvas">
    <div class="mx-auto max-w-[1200px] px-6 py-20 sm:py-24">
      <div class="mx-auto mb-12 max-w-[640px] text-center">
        <h2 class="mb-4 text-[clamp(30px,4vw,42px)]">Four steps, about ten minutes the first time</h2>
        <p class="m-0 text-[18px] text-ink-2">After that, import your JSON and a new application takes a minute, because only the job posting changes.</p>
      </div>
      <ol class="m-0 grid list-none gap-5 p-0 md:grid-cols-2">
        <li class="rounded-[22px] bg-paper p-8 shadow-[var(--shadow-card)]">
          <span class="mb-5 block font-mono text-[13px] font-medium text-ink-3">01</span>
          <h3 class="mb-2.5 text-[19px]">Bring what you have</h3>
          <p class="m-0 text-[15.5px] text-ink-2">Drop in your current resume as a PDF and the text is pulled out in your browser, sorted into fields you then correct. Starting from nothing works too.</p>
        </li>
        <li class="rounded-[22px] bg-paper p-8 shadow-[var(--shadow-card)]">
          <span class="mb-5 block font-mono text-[13px] font-medium text-ink-3">02</span>
          <h3 class="mb-2.5 text-[19px]">See what the machine reads</h3>
          <p class="m-0 text-[15.5px] text-ink-2">The parser view shows your document as plain extracted text, the way the employer's software receives it. Anything wrong there is wrong on their screen.</p>
        </li>
        <li class="rounded-[22px] bg-paper p-8 shadow-[var(--shadow-card)]">
          <span class="mb-5 block font-mono text-[13px] font-medium text-ink-3">03</span>
          <h3 class="mb-2.5 text-[19px]">Answer the actual posting</h3>
          <p class="m-0 text-[15.5px] text-ink-2">Paste the job description and see which required terms your resume already contains, and which are missing. You decide which missing ones are true of you.</p>
        </li>
        <li class="rounded-[22px] bg-paper p-8 shadow-[var(--shadow-card)]">
          <span class="mb-5 block font-mono text-[13px] font-medium text-ink-3">04</span>
          <h3 class="mb-2.5 text-[19px]">Download and keep the JSON</h3>
          <p class="m-0 text-[15.5px] text-ink-2">Print to a PDF that keeps a real text layer, then export the JSON so the next application only costs you the posting step.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- faq -->
  <section id="faq" class="mx-auto max-w-[1200px] px-6 py-20 sm:py-24">
    <div class="mx-auto mb-10 max-w-[640px] text-center">
      <h2 class="mb-4 text-[clamp(30px,4vw,42px)]">What people ask before they trust a resume checker</h2>
    </div>
    <div class="faq mx-auto max-w-[760px]">
      {faq.map((f) => (
        <details class="border-b border-rule">
          <summary class="relative cursor-pointer list-none py-5 pr-10 font-display text-[18px] font-semibold leading-snug after:absolute after:right-1 after:top-[18px] after:font-sans after:text-[24px] after:font-normal after:leading-none after:text-ink-3">{f.q}</summary>
          <div class="pb-6 pr-10 text-[16px] text-ink-2"><p class="mb-0">{f.a}</p></div>
        </details>
      ))}
    </div>
  </section>
</main>

