---
import '../styles/global.css';

const site = 'https://resume.nicolaslecocq.com';
const title = 'Free ATS Friendly Resume Checker · Parseable';
const description =
  'Free ATS friendly resume checker. Paste a job posting, see which required keywords you match, and export a PDF screening software reads correctly.';

// The demo resume as real markup, so the object on the stage is the product at print size.
// The summary carries fixed breaks and every line is one line, so both faces share one geometry.
const demoSheet = `
<header class="s-head"><div class="s-head-txt"><h1 class="s-name">Marie Dubois</h1><p class="s-role">Senior Backend Engineer</p><p class="s-contact"><span>marie.dubois@example.com</span><span class="sep">|</span><span>+33 6 12 34 56 78</span><span class="sep">|</span><span>Lyon, France, remote across CET</span></p></div></header>
<section><h2>Professional Summary</h2><p class="s-summary">Backend engineer with nine years on payment systems in <b class="lit">Python</b> and <b class="lit">Go</b>.</p><p class="s-summary">Led a monolith to services migration at four thousand requests per second.</p></section>
<section><h2>Skills</h2><p class="s-skill"><b>Languages:</b> <b class="lit">Python</b>, <b class="lit">Go</b>, SQL, TypeScript</p><p class="s-skill"><b>Infrastructure:</b> <b class="lit">Kubernetes</b>, <b class="lit">Docker</b>, <b class="lit">PostgreSQL</b>, Terraform, AWS</p><p class="s-skill"><b>Practices:</b> <b class="lit">CI/CD</b>, on call, incident reviews, technical writing</p></section>
<section><h2>Experience</h2>
<div class="s-item"><div class="s-item-head"><p class="s-item-title">Senior Backend Engineer</p><span class="s-item-dates">2021 - 2026</span></div><p class="s-item-org">Payfit, Paris</p><ul><li>Rebuilt the billing service in <b class="lit">Go</b> and cut p99 latency from 800ms to 90ms.</li><li>Mentored four engineers through the migration and ran the on call rotation.</li><li>Wrote the incident review process the whole platform team now follows.</li></ul></div>
<div class="s-item"><div class="s-item-head"><p class="s-item-title">Backend Engineer</p><span class="s-item-dates">2017 - 2021</span></div><p class="s-item-org">Doctolib, Paris</p><ul><li>Shipped the appointment reminder pipeline, sending two million messages a day.</li><li>Moved the search index to a managed cluster with zero downtime.</li></ul></div>
</section>
<section><h2>Education</h2><div class="s-item"><div class="s-item-head"><p class="s-item-title">MSc Computer Science</p><span class="s-item-dates">2015 - 2017</span></div><p class="s-item-org">INSA Lyon</p></div></section>`;

const faq = [
  {
    q: 'What is an ATS and why does it reject resumes?',
    a: 'An applicant tracking system is the software an employer uses to receive applications. It extracts the text from your file, sorts it into fields such as employer, job title and dates, then scores those fields against the job requisition. Most resumes fail at the sorting step rather than the scoring step. A two column layout with a skills sidebar is the usual culprit, because the extractor reads the page in one pass and interleaves the columns, so your employer and your dates land in the wrong fields before anyone reads a word.',
  },
  {
    q: 'Does this ATS friendly resume checker store my data?',
    a: 'Nothing is stored, because there is no database, no account and no server that receives your file. Your resume, your photo and the job posting you paste are held in the browser tab and disappear when you close it. That is also why the JSON export exists: it is the only copy, so download it if you want to come back later.',
  },
  {
    q: 'Should I put white keywords on my resume to get past the AI?',
    a: 'No, and this builder will not do it. Parsers strip styling and read the raw text layer, so a block of white on white keywords lands in the middle of the recruiter screen looking exactly like what it is. Screening platforms flag the pattern, and a flagged application can be rejected automatically with a fraud marker attached to your candidate record, which follows you across every future role at that company. The same applies to hidden instructions aimed at an AI reader. Putting the same words in visibly, inside your summary and your real bullets, scores identically and survives a human reading it.',
  },
  {
    q: 'What resume format parses most reliably?',
    a: 'A PDF with a real text layer, in one column, with standard headings such as Professional Summary, Experience, Skills and Education. Keep your contact details in the body of the document rather than in a page header, use one date format throughout, and avoid tables, text boxes and letter spacing on headings. Letter spacing is the quiet one: it survives into the text layer and your heading comes out as a string of separated capitals that no parser recognises.',
  },
  {
    q: 'Should I put a photo on my resume?',
    a: 'It depends where you are applying. A photo is normal in France, Germany, Switzerland, Spain and much of continental Europe. In the United Kingdom, Ireland and the United States it is usually left off, because employers avoid material that could support a discrimination claim. The photo toggle is off by default here, so turn it on only when you know the local convention.',
  },
  {
    q: 'How long should a resume be?',
    a: 'One page for under about eight years of work, two pages beyond that. Cutting a fifteen year career onto one page throws away keyword surface that the requisition is scoring you on, and no recruiter has ever rejected a strong second page. What does hurt is padding, so every line should either carry a keyword the job asked for or a result worth reading.',
  },
  {
    q: 'Can I check a resume I already have against a job description?',
    a: 'Yes, and that is what the posting step is for. Drop your current resume in as a PDF and the text is extracted in your browser, then sorted into fields for you to correct, which takes a couple of minutes on most files. Paste the job description into the posting step and the checker lists every required term the posting asks for, marks the ones your resume already contains, and shows a match rate. You decide which of the missing terms are genuinely true of you before any of them is added.',
  },
  {
    q: 'Is it really free, and can I run it myself?',
    a: 'It is free and you can run your own copy. The code is MIT licensed on GitHub, there is nothing to pay for and nothing to sign up to. Since the whole thing is a static page with no backend, you can clone the repository and host your own copy anywhere that serves files.',
  },
];

const steps = [
  { id: 'details', label: 'Details' },
  { id: 'template', label: 'Template' },
  { id: 'posting', label: 'Job posting' },
  { id: 'export', label: 'Download' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}/#app`,
      name: 'Parseable',
      url: site,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Any browser',
      description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Import an existing resume from PDF in the browser',
        'Match a resume against a job posting and score the required keywords',
        'Show the exact text an applicant tracking system extracts',
        'Export and re-import a resume as JSON',
        'Print to a PDF with a real text layer',
      ],
      author: { '@id': `${site}/#author` },
      isAccessibleForFree: true,
    },
    {
      '@type': 'Person',
      '@id': `${site}/#author`,
      name: 'Nicolas Lecocq',
      url: 'https://nicolaslecocq.com/',
      jobTitle: 'Full Stack Developer',
    },
    {
      '@type': 'FAQPage',
      '@id': `${site}/#faq`,
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    {
      '@type': 'HowTo',
      name: 'How to build a resume that passes an ATS',
      description: 'Import your existing resume, correct the extracted fields, pick a template, paste the job posting, then export a PDF with a real text layer.',
      totalTime: 'PT10M',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Import', text: 'Drop in your current resume as a PDF, or import a JSON file you exported here before.' },
        { '@type': 'HowToStep', position: 2, name: 'Correct the details', text: 'Check the fields the extractor filled in and add anything it missed.' },
        { '@type': 'HowToStep', position: 3, name: 'Pick a template', text: 'Choose one of three single column layouts, all built to parse cleanly.' },
        { '@type': 'HowToStep', position: 4, name: 'Match the posting', text: 'Paste the job description and see which required keywords your resume already contains.' },
        { '@type': 'HowToStep', position: 5, name: 'Download', text: 'Print to PDF, and export the JSON so the next application takes a minute.' },
      ],
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site + '/'} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="preload" href="/fonts/plex-2.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/plex-serif-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={site + '/'} />
  <meta property="og:title" content="Parseable, a free ATS friendly resume checker" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={site + '/og.png'} />
  <meta property="og:locale" content="en" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Parseable, a free ATS friendly resume checker" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={site + '/og.png'} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</head>
<body>

<header class="site-head fixed inset-x-0 top-0 z-40 transition-colors duration-300" data-head>
  <div class="mx-auto grid h-16 max-w-[1180px] grid-cols-[1fr_auto_1fr] items-center px-6">
    <a href="/" class="font-ui text-[16px] font-semibold tracking-[-0.01em] text-ink no-underline">Parseable</a>
    <nav class="hidden items-center gap-7 text-[14px] md:flex">
      <a href="#read" class="text-ink-2 no-underline transition-colors hover:text-ink">Why resumes fail</a>
      <a href="#how" class="text-ink-2 no-underline transition-colors hover:text-ink">How it works</a>
      <a href="#faq" class="text-ink-2 no-underline transition-colors hover:text-ink">Questions</a>
      <a href="https://github.com/DigiHold/parseable" rel="noopener" target="_blank" class="text-ink-2 no-underline transition-colors hover:text-ink">Source</a>
    </nav>
    <div class="col-start-3 flex justify-end"><button class="cursor-pointer border-0 bg-transparent p-0 text-[14px] font-medium text-ink underline decoration-edge underline-offset-4 hover:decoration-ink" data-action="pick-pdf">Upload</button></div>
  </div>
</header>

<main class="dropzone" data-drop="pdf">
  <!-- the hero: the resume itself, large and flat, read by a blade of light -->
  <section class="hero-light mx-auto max-w-[1180px] px-6 pt-24 sm:pt-28" data-stage>
    <div class="hero-copy mx-auto max-w-[720px] text-center">
      <h1 class="mb-6 font-medium leading-[1.0] tracking-[-0.02em] text-[clamp(40px,5.6vw,80px)]"><span class="block sm:whitespace-nowrap">Get past the software</span><span class="block sm:whitespace-nowrap">and in front of a person</span></h1>
      <p class="mx-auto mb-7 text-[18px] leading-[1.55] text-ink-2"><span class="sm:block">A free ATS friendly resume checker that runs in your browser,</span> <span class="sm:block">and shows you what the software reads.</span></p>
      <div class="flex flex-col items-center gap-3">
        <button class="btn btn-primary btn-xl w-full rounded-none sm:w-auto" data-action="pick-pdf">Upload your resume</button>
        <p class="m-0 font-mono text-[12px] text-ink-3">A PDF file, and it never leaves your browser.</p>
      </div>
      <input type="file" accept="application/pdf" class="hidden" data-file="pdf">
      <input type="file" accept="application/json,.json" class="hidden" data-file="json">
      <p class="mt-3 text-[13px] text-ink-3 empty:hidden" data-role="pdf-status"></p>
    </div>

    <div class="hero-object" aria-label="A sample resume: above the line, the text a screening system has already read from it">
      <div class="scene">
        <div class="spill" aria-hidden="true"></div>
        <div class="obj">
          <div class="face face-human"><article class="sheet" data-tpl="classic" set:html={demoSheet}></article></div>
          <div class="face face-machine" aria-hidden="true"><article class="sheet" data-tpl="classic" set:html={demoSheet}></article></div>
          <div class="light" aria-hidden="true"></div>
          <div class="blade" aria-hidden="true"><span class="blade-count" data-role="lines-read"></span></div>
          <div class="edge" aria-hidden="true"></div>
        </div>
        <div class="floor" aria-hidden="true"></div>
      </div>
      <p class="hero-caption"><button type="button" data-action="sample">Open this sample in the tool</button></p>
    </div>
  </section>

  <section id="workspace" class="mx-auto max-w-[1180px] px-6 pb-20 pt-14" hidden>
    <div class="tool">
      <div class="tool-form">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-1 border-b border-rule px-5 pt-3">
          <ol class="m-0 flex list-none flex-wrap gap-x-6 gap-y-1 p-0" id="steps">
            {steps.map((s, i) => (
              <li>
                <button class="step-btn" data-step={s.id} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="step-num"><span>{i + 1}</span></span>
                  <span class="step-label">{s.label}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
        <p class="m-0 border-b border-rule px-5 py-3 text-[13px] text-ink-3" data-role="demo-note">A sample resume is loaded. Upload yours to replace it, or <button class="cursor-pointer border-0 bg-transparent p-0 text-[inherit] underline hover:text-ink" data-action="blank">start from scratch</button>.</p>
        <div id="panels"></div>
        <div class="flex gap-3 border-t border-rule px-5 py-4">
          <button class="btn btn-ghost" data-nav="prev">Back</button>
          <button class="btn btn-primary" data-nav="next">Continue</button>
        </div>
      </div>

      <div class="tool-view">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-rule px-5 pt-3">
          <div class="flex gap-5" role="tablist" aria-label="Preview mode">
            <button class="step-btn" role="tab" aria-selected="true" data-view="human">What a person sees</button>
            <button class="step-btn" role="tab" aria-selected="false" data-view="parser">What the software reads</button>
          </div>
          <div class="zoomctl ml-auto flex items-center gap-1 pb-2">
            <button class="icon-btn" data-zoom="-1" aria-label="Zoom out">−</button>
            <span class="min-w-[40px] text-center font-mono text-[12px] text-ink-3" id="zoomval">66%</span>
            <button class="icon-btn" data-zoom="1" aria-label="Zoom in">+</button>
          </div>
          <button class="btn btn-ghost btn-sm pb-2" data-action="print">Download PDF</button>
        </div>
        <div class="stage max-h-[70vh] overflow-auto bg-canvas p-5">
          <div class="sheet-scale flex origin-top-left justify-start transition-transform duration-200" id="scale">
            <article class="sheet" id="sheet" data-tpl="classic"></article>
          </div>
          <div class="parser-out">
            <pre class="m-0 whitespace-pre-wrap break-words border border-rule bg-paper p-6 font-mono text-[12.5px] leading-[1.7] text-ink" id="parser"></pre>
          </div>
        </div>
      </div>
    </div>
  </section>



  <!-- why resumes fail, in the extractor's own output -->
  <section id="read" class="scroll-mt-[80px]">
    <div class="mx-auto max-w-[1180px] px-6 py-24">
      <div class="mb-12 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16" data-reveal>
        <h2 class="max-w-[16ch] text-[clamp(30px,3.2vw,44px)]">What the software read from a two column resume</h2>
        <p class="m-0 max-w-[48ch] self-end text-[17px] leading-relaxed text-ink-2">The extractor reads a page in one pass and interleaves the columns. This is its output for a real resume with a skills sidebar, and the three places where the application dies are marked on it.</p>
      </div>
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)] lg:gap-10" data-reveal>
        <div class="panel">
          <div class="panel-bar"><span>extracted text</span><span class="ml-auto">pdftotext, one pass</span></div>
          <pre aria-label="Text extracted by a parser">NICOLAS LECOCQ
Full Stack Developer

<s>Skills</s>                    <s>Experience</s>
<b>WordPress                 Founder &amp; Developer          2025 - 2026</b> <i class="mk">1</i>
HTML/CSS                  At Vayalis, my own company, I develop and
Vercel                    launch my own products, handling the full
Cloudflare                cycle from idea to release.
React                     <b>Web Designer                   2023 - 2025</b>
Next.js                   Trivial Mass SA, Lausanne
Node.js                   Graphic integration, website development,
PHP                       <i>client follow up management</i> <i class="mk">2</i>, as well as
SQL                       invoicing.

<s>Language</s>                  <i>client relations to understand their</i>
French                    <i>requirements</i>, and monitoring the specs. <i class="mk">3</i>
English</pre>
        </div>
        <ol class="notes-col">
          <li><span class="mk">1</span><div><h3>The layout breaks the extractor</h3><p>"WordPress" and "Founder" land on one line, so the parser files the job title under the skills column and the employer under nothing at all.</p></div></li>
          <li><span class="mk">2</span><div><h3>The words do not match the posting</h3><p>The posting asked for "stakeholder management". The resume says "client follow up" and "client relations", so that requirement scores zero, whatever the work was.</p></div></li>
          <li><span class="mk">3</span><div><h3>Nobody tells you which one it was</h3><p>The rejection email is the same in both cases, so most people rewrite the cover letter and send the same unreadable file again.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- how it works: the tool's own screens -->
  <section id="how" class="scroll-mt-[80px]">
    <div class="mx-auto max-w-[1180px] px-6 py-24">
      <div class="mb-14" data-reveal>
        <h2 class="mb-4 max-w-[28ch] text-[clamp(30px,3.2vw,44px)]">Four steps, about ten minutes the first time</h2>
        <p class="m-0 max-w-[60ch] text-[17px] leading-relaxed text-ink-2">After that, import your JSON and a new application takes a minute, because only the job posting changes. Everything runs in the tab, nothing is uploaded.</p>
      </div>
      <div class="feature" data-reveal>
        <figure class="shot"><picture><source srcset="/img/shot-parser.avif" type="image/avif"><img src="/img/shot-parser.webp" alt="The tool with a resume loaded: the fields on the left, and on the right the plain text a parser extracts from the page" width="2264" height="1744" loading="lazy" decoding="async"></picture></figure>
        <ol class="feature-steps">
          <li><span class="mk">1</span><div><h3>Bring what you have</h3><p>Drop in your current resume as a PDF and the text is pulled out in your browser, sorted into fields you then correct. Starting from nothing works too.</p></div></li>
          <li><span class="mk">2</span><div><h3>See what the machine reads</h3><p>The parser view shows your document as plain extracted text, the way the employer's software receives it. Anything wrong there is wrong on their screen.</p></div></li>
        </ol>
      </div>
      <div class="feature feature-flip" data-reveal>
        <figure class="shot"><picture><source srcset="/img/shot-match.avif" type="image/avif"><img src="/img/shot-match.webp" alt="The match against a pasted job posting: the rate, the matched terms and the missing ones" width="2264" height="1744" loading="lazy" decoding="async"></picture></figure>
        <ol class="feature-steps" start="3">
          <li><span class="mk">3</span><div><h3>Answer the actual posting</h3><p>Paste the job description and see which required terms your resume already contains, and which are missing. You decide which missing ones are true of you.</p></div></li>
          <li><span class="mk">4</span><div><h3>Download and keep the JSON</h3><p>Print to a PDF that keeps a real text layer, then export the JSON so the next application only costs you the posting step.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- questions: title and a help card on the left, the answers on the right -->
  <section id="faq" class="scroll-mt-[80px]">
    <div class="mx-auto max-w-[1180px] px-6 py-24">
      <div class="mx-auto mb-12 max-w-[60ch] text-center" data-reveal>
        <h2 class="mb-4 text-[clamp(30px,3.2vw,44px)]">Frequently asked questions</h2>
        <p class="m-0 text-[17px] leading-relaxed text-ink-2">Short answers, and the reasons behind them. The one on white keywords is the one most people arrive with.</p>
      </div>
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <div data-reveal>
        <dl class="facts">
          <div><dt>Account</dt><dd>There is nothing to sign up to.</dd></div>
          <div><dt>Storage</dt><dd>Your file stays in the tab and is never sent.</dd></div>
          <div><dt>Cost</dt><dd>Free, and open source under MIT.</dd></div>
          <div><dt>Questions left</dt><dd><a href="https://github.com/DigiHold/parseable/issues" rel="noopener" target="_blank" class="text-ink">Open an issue on GitHub</a>, they are read.</dd></div>
        </dl>
      </div>
      <div class="faq-acc" data-reveal>
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- closing -->
  <section class="mx-auto max-w-[1180px] px-6 pb-8">
    <div class="closing" data-reveal>
      <h2 class="mx-auto mb-8 max-w-[22ch] text-[clamp(30px,3.2vw,44px)]">Software reads it first, so make sure it reads it right.</h2>
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-x-5">
        <button class="btn btn-primary btn-xl" data-action="pick-pdf">Upload your resume</button>
        <p class="m-0 text-[15px] text-ink-2">or <button class="cursor-pointer border-0 bg-transparent p-0 text-[inherit] text-ink underline decoration-edge underline-offset-4 hover:decoration-ink" data-action="sample">try it with a sample</button></p>
      </div>
    </div>
  </section>
</main>

<footer class="mx-auto max-w-[1180px] px-6 pb-10 pt-16">
  <div class="grid gap-10 sm:grid-cols-3">
    <div>
      <p class="m-0 mb-3 font-ui text-[15px] font-semibold text-ink">Parseable</p>
      <p class="m-0 max-w-[30ch] text-[14px] leading-relaxed text-ink-2">A free ATS friendly resume checker. It runs in your browser, uploads nothing and stores nothing.</p>
    </div>
    <nav class="grid content-start gap-2 text-[14px]">
      <a href="#read" class="text-ink-2 no-underline transition-colors hover:text-ink">Why resumes fail</a>
      <a href="#how" class="text-ink-2 no-underline transition-colors hover:text-ink">How it works</a>
      <a href="#faq" class="text-ink-2 no-underline transition-colors hover:text-ink">Questions</a>
      <a href="https://github.com/DigiHold/parseable" rel="noopener" target="_blank" class="text-ink-2 no-underline transition-colors hover:text-ink">Source on GitHub</a>
      <a href="https://github.com/DigiHold/parseable/blob/main/LICENSE" rel="noopener" target="_blank" class="text-ink-2 no-underline transition-colors hover:text-ink">MIT licence</a>
